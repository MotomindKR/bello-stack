    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <joint name="stereo_left_camera_optical_frame_mount" type="fixed">
    <parent link="stereo_camera_link" />
    <child link="stereo_left_camera_optical_frame" />
    <origin xyz="0 0.029600000000000001 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <joint name="stereo_right_camera_optical_frame_mount" type="fixed">
    <parent link="stereo_camera_link" />
    <child link="stereo_right_camera_optical_frame" />
    <origin xyz="0 -0.029600000000000001 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <!-- Finite ground plane: top at z=0, thickness entirely below the robot. -->
  <link name="ground_link">
    <visual name="ground_surface_visual">
      <geometry>
        <box size="2.0 2.0 0.020" />
      </geometry>
      <material name="workcell_ground" />
    </visual>
    <collision name="ground_surface">
      <geometry>
        <box size="2.0 2.0 0.020" />
      </geometry>
    </collision>
  </link>
  <joint name="ground_mount" type="fixed">
    <parent link="dual_milly_base" />
    <child link="ground_link" />
    <origin xyz="0 0 -0.010" rpy="0 0 0" />
  </joint>
  <!-- Square support reaches from ground z=0 to the gimbal plate underside. -->
  <link name="gimbal_support_link">
    <visual name="gimbal_support_visual">
      <geometry>
        <box size="0.060 0.060 0.430" />
      </geometry>
      <material name="gimbal_metal" />
    </visual>
    <collision name="gimbal_support">
      <geometry>
        <box size="0.060 0.060 0.430" />
      </geometry>
    </collision>
  </link>
  <joint name="gimbal_support_mount" type="fixed">
    <parent link="dual_milly_base" />
    <child link="gimbal_support_link" />
    <origin xyz="0.0875 0 0.215" rpy="0 0 0" />
  </joint>
  <joint name="gimbal_mount" type="fixed">
    <parent link="dual_milly_base" />
    <child link="gimbal_base_link" />
    <origin xyz="0.0875 0 0.430" rpy="0 0 3.141592653589793" />
  </joint>
  <link name="left_gripper_tcp" />
  <joint name="left_gripper_tcp_mount" type="fixed">
    <parent link="left_gripper_base" />
    <child link="left_gripper_tcp" />
    <origin xyz="0 0 0.0795" rpy="3.141592653589793 0 0" />
  </joint>
  <link name="right_gripper_tcp" />
  <joint name="right_gripper_tcp_mount" type="fixed">
    <parent link="right_gripper_base" />
    <child link="right_gripper_tcp" />
    <origin xyz="0 0 0.0795" rpy="3.141592653589793 0 0" />
