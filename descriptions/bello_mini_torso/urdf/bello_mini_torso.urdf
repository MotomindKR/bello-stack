<?xml version='1.0' encoding='utf-8'?>
<robot name="bello_mini_torso">
  <!--Derived from bello_mini: fixed base, active shared torso pitch, waist and both arms. See ../ASSET_PROVENANCE.md.-->
  <!--base_link is the midpoint of the source hip-pitch axes, at world zero. The user requested an invisible base; no base mesh, floor plane, or stand inertia is added.-->
  <!--The source pelvis frame is preserved by a fixed offset. Its inertia is expressed on torso_pitch_link without changing the physical mass distribution.-->
  <!--User-specified pitch travel: 60 degrees forward, 30 degrees backward. The 240 Nm effort envelope sums the source hip envelopes; physical calibration remains separate.-->
  <link name="base_link" />
  <link name="torso_pitch_link">
    <inertial>
      <origin xyz="0.00076623038541579445 0 0.028238543869593125" rpy="0 0 0" />
      <mass value="4.396505078066963" />
      <inertia ixx="0.017878298864020866" ixy="0" ixz="8.8747753963781351e-05" iyy="0.016838841717648798" iyz="0" izz="0.010732361203565306" />
    </inertial>
  </link>
  <joint name="torso_pitch_joint" type="revolute">
    <parent link="base_link" />
    <child link="torso_pitch_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.5235987755982989" upper="1.0471975511965979" effort="240" velocity="15" />
  </joint>
  <joint name="torso_pitch_to_pelvis_joint" type="fixed">
    <parent link="torso_pitch_link" />
    <child link="pelvis_link" />
    <origin xyz="0.0099999999999894115 0 0.180000001143162" rpy="0 0 0" />
  </joint>
  <link name="left_hip_pitch_mount_frame" />
  <joint name="left_hip_pitch_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="left_hip_pitch_mount_frame" />
    <origin xyz="0 0.033596880771079501 0" rpy="0 0 0" />
  </joint>
  <link name="right_hip_pitch_mount_frame" />
  <joint name="right_hip_pitch_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="right_hip_pitch_mount_frame" />
    <origin xyz="0 -0.033596880771079501 0" rpy="0 0 0" />
  </joint>
  <!--Designer-provided joint ranges use user-reviewed left-side signs; right roll/yaw signs are mirrored and physical stops require validation.-->
  <!--Astra Stereo S U3 sensor origins are nominal mechanical values: IR/depth is 2 mm behind the CAD front face; RGB is 2 mm forward of IR/depth. They are not factory-calibrated extrinsics.-->
  <!--Publish camera sensor TFs from this URDF or from the Orbbec driver, never from both sources simultaneously.-->
  <!--Left/right mass properties use mirrored spatial-inertia means; central-body inertials are symmetrized about y=0. Existing signed joint conventions are preserved.-->
  <!--imu_link is the published logical IMU frame; imu_sensor_link is the coincident physical EBIMU frame and records its upside-down mounting.-->
