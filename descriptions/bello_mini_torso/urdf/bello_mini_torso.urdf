  <!--Both hip actuators drive torso_pitch_joint in parallel. Separate SimpleTransmission mappings share one joint; efforts add and motor targets must agree in joint coordinates.-->
  <!--Hip reductions are -1 in the source normalized joint coordinates because the pelvis now moves relative to the fixed leg-side mounts. Raw encoder directions and zero calibration remain hardware concerns.-->
  <transmission name="left_hip_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="torso_pitch_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_pitch_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>-1</mechanicalReduction>
    </actuator>
  </transmission>
