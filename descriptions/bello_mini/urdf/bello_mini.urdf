<?xml version='1.0' encoding='utf-8'?>
<robot name="bello_mini">
  <!--Designer-provided joint ranges use a provisional left-sign mapping; right roll/yaw signs are mirrored and all signs/stops require review.-->
  <!--Astra Stereo S U3 sensor origins are nominal mechanical values: IR/depth is 2 mm behind the CAD front face; RGB is 2 mm forward of IR/depth. They are not factory-calibrated extrinsics.-->
  <!--Publish camera sensor TFs from this URDF or from the Orbbec driver, never from both sources simultaneously.-->
  <!--imu_link is 50 mm below the midpoint of the left/right hip-pitch joint origins and yawed -pi/2 from pelvis_link so its +X-right, +Y-forward, +Z-up axes match original Bello.-->
  <mujoco>
    <compiler fusestatic="false" inertiafromgeom="false" />
  </mujoco>
  <material name="center_links">
    <color rgba="0.32 0.36 0.42 1" />
  </material>
  <material name="left_links">
    <color rgba="0.17 0.46 0.73 1" />
  </material>
  <material name="right_links">
    <color rgba="0.91 0.36 0.18 1" />
  </material>
  <material name="anonymous_end_effector">
    <color rgba="0.85 0.85 0.88 1" />
  </material>
